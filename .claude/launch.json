{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && .venv\\Scripts\\python -m alembic upgrade head && .venv\\Scripts\\python -m app.seed && .venv\\Scripts\\python -m uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--host",
        "127.0.0.1"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    }
  ]
}